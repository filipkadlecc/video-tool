Output out.mp4
# A vhs tape — terminal recording as code.
# Docs: https://github.com/charmbracelet/vhs
#
# Output is rendered to out.mp4 by the "Render" button.



Set FontSize 22
Set Width 1200
Set Height 600
Set Theme "Catppuccin Mocha"
Set TypingSpeed 50ms

Type "echo 'Hello from VHS'"
Sleep 500ms
Enter
Sleep 1s

Type "ls -la"
Sleep 500ms
Enter
Sleep 2s
