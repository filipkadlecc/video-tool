# Required: Anthropic API key for the AI generation features
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Notion integration (only needed if you wire scripts to Notion pages)
NOTION_API_KEY=

# Optional: overrides the vhs binary for terminal renders. Leave empty to use vhs
# on PATH. Avoid 0.12.0, it never writes the video; 0.11.0 and 0.12.1+ work.
VHS_BIN=

# Optional: Remotion company licence. Public key from remotion.pro -> License keys,
# read by remotion.config.ts to report renders for seat tracking.
REMOTION_PUBLIC_LICENSE_KEY=
